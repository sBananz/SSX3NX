# Binary assets go through Git LFS
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
*.whl  filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
*.dmp  filter=lfs diff=lfs merge=lfs -text
*.xmv  filter=lfs diff=lfs merge=lfs -text
*.dds  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mkv  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text

# The controller art is small and stored as plain files, so it is in the
# source zip and raw links as real images: not through LFS. (A png rule
# without this made git status show them modified forever.)
art/** !filter !diff !merge binary

# Windows-side scripts keep CRLF; shell scripts and patches stay LF
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
*.patch text eol=lf
