+/* The stage's DXT texture as it is in memory, for a backend that samples
+ * BC1/2/3 itself: the host pointer to the base level, *dxt 1 / 3 / 5, *mips
+ * the levels (the FORMAT count, clamped to the chain down to 1x1) and *bytes
+ * the chain's size, the levels one after another with partial blocks
+ * rounded up (as the NV2A lays them out). NULL for anything else -- not
+ * DXT, a cube map, or a zero size. */
+const void *nv2a_exec_tex_dxt(int stage, int *dxt, uint32_t *mips, size_t *bytes)
+{
+    const Texture *t;
+    uint32_t bb, l, w, h, maxl = 1, n;
+    size_t sz = 0;
+    if (stage < 0 || stage > 3)
+        return NULL;
+    t = &s_gpu.texs[stage];
+    if (!t->valid || t->cube || !t->width || !t->height
+        || !(bb = d3d8_format_dxt_block_bytes(t->color)))
+        return NULL;
+    for (l = t->width > t->height ? t->width : t->height; l > 1; l >>= 1)
+        maxl++;
+    n = t->levels ? t->levels : 1;
+    if (n > maxl)
