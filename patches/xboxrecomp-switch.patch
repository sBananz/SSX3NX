+/*
+ * xbox_guest_regs.c - the thread entry for XBOX_GUEST_REGS
+ * (xbox_guest_regs.h): the guest registers in CPU registers.
+ * After OpenTrickyNX's xbox_guest_regs.c (GPL-3.0-only).
+ */
+#ifdef XBOX_GUEST_REGS_IN_CPU
+/* A thread that runs guest code starts through this: x19-x26 zeroed like the
+ * __thread copies, and the caller's values back on return, since whatever
+ * started the thread (pthread, libnx's crt0) expects its callee-saved
+ * registers kept.
+ *
+ *   x0 = fn, x1 = arg  ->  fn(arg)
+ */
+__asm__(
+    "    .text\n"
+    "    .global xbox_guest_regs_call\n"
+    "    .type   xbox_guest_regs_call, %function\n"
+    "    .align  2\n"
+    "xbox_guest_regs_call:\n"
+    "    stp  x29, x30, [sp, #-96]!\n"
+    "    mov  x29, sp\n"
+    "    stp  x19, x20, [sp, #16]\n"
+    "    stp  x21, x22, [sp, #32]\n"
+    "    stp  x23, x24, [sp, #48]\n"
+    "    stp  x25, x26, [sp, #64]\n"
+    "    str  x27, [sp, #80]\n"
+#if defined(XBOX_GUEST_TS_IN_BLOCK)
+    /* x27 = &g_guest_ts of this thread, for the generated code */
+    "    mov  x19, x0\n"
+    "    mov  x20, x1\n"
+    "    bl   xbox_guest_ts_self\n"
+    "    mov  x27, x0\n"
+    "    mov  x0, x19\n"
+    "    mov  x1, x20\n"
+#endif
+    "    mov  x16, x0\n"
+    "    mov  x0, x1\n"
+    "    mov  x19, xzr\n"
+    "    mov  x20, xzr\n"
+    "    mov  x21, xzr\n"
+    "    mov  x22, xzr\n"
+    "    mov  x23, xzr\n"
+    "    mov  x24, xzr\n"
+    "    mov  x25, xzr\n"
+    "    mov  x26, xzr\n"
+    "    blr  x16\n"
+    "    ldp  x19, x20, [sp, #16]\n"
+    "    ldp  x21, x22, [sp, #32]\n"
+    "    ldp  x23, x24, [sp, #48]\n"
+    "    ldp  x25, x26, [sp, #64]\n"
+    "    ldr  x27, [sp, #80]\n"
+    "    ldp  x29, x30, [sp], #96\n"
+    "    ret\n"
+    "    .size   xbox_guest_regs_call, . - xbox_guest_regs_call\n");
+#else
+/* ISO C forbids an empty translation unit */
+typedef int xbox_guest_regs_unused_t;
+#endif
