new file mode 100644
index 0000000..0947ad9
--- /dev/null
+++ b/src/kernel/xbox_guest_regs.h
@@ -0,0 +1,139 @@
+/*
+ * xbox_guest_regs.h - the guest x86 registers in host CPU registers
+ * (SSX3NX; after OpenTrickyNX's xboxrecomp/src/kernel/xbox_guest_regs.h,
+ * GPL-3.0-only).
+ *
+ * The translated code reads and writes eax..esp as the globals g_eax..g_esp,
+ * and every x87 instruction touches g_fp_top. By default they are __thread
+ * variables (xbox_memory_layout.c): every access goes through the thread
+ * pointer -- on the Switch (-mtp=soft) a function call -- and since any guest
+ * memory store may alias them, the compiler reloads them after each one.
+ *
+ * With XBOX_GUEST_REGS (GCC on AArch64) they are global register variables
+ * instead, pinned to callee-saved registers:
+ *
+ *     w19 eax   w20 ecx   w21 edx   w22 ebx   w23 esi   w24 edi   w25 esp
+ *     w26 the x87 stack top
+ *
+ * Each OS thread has its own register file, so they stay per-thread like the
+ * __thread copies, and an access is a register move. The build force-includes
+ * this header into every C file of the program (CMakeLists.txt), so none of
+ * our code uses those registers for anything else; the libraries we link
+ * (libnx, newlib, SDL, Mesa) see ordinary callee-saved registers and preserve
+ * them.
+ *
+ * What changes with them:
+ *  - a thread that may run guest code starts through xbox_guest_regs_call(),
+ *    which zeroes them (the __thread copies started at 0) and restores the
+ *    caller's x19-x26 for whatever started the thread (win32_compat.c's
+ *    thread trampolines, the Switch main());
+ *  - longjmp() restores them to their setjmp() values (recomp_guest_longjmp
+ *    patches the jmp_buf so the guest's values survive);
+ *  - their address cannot be taken (the watchdog's register view is off).
+ * -DSSX3NX_GUEST_REGS=OFF at configure time goes back to __thread.
+ */
+#ifndef XBOX_GUEST_REGS_H
+#define XBOX_GUEST_REGS_H
+
+#if defined(XBOX_GUEST_REGS) && defined(__aarch64__) && defined(__GNUC__) && !defined(__clang__) \
+    && !defined(__cplusplus) && !defined(__ASSEMBLER__)
+#define XBOX_GUEST_REGS_IN_CPU 1
+
+/* No system header here: this is included ahead of a file's own
+ * _GNU_SOURCE and the like. __UINT32_TYPE__ is uint32_t's type. */
+register __UINT32_TYPE__ g_eax __asm__("w19");
+register __UINT32_TYPE__ g_ecx __asm__("w20");
+register __UINT32_TYPE__ g_edx __asm__("w21");
+register __UINT32_TYPE__ g_ebx __asm__("w22");
+register __UINT32_TYPE__ g_esi __asm__("w23");
+register __UINT32_TYPE__ g_edi __asm__("w24");
+register __UINT32_TYPE__ g_esp __asm__("w25");
+register int g_fp_top __asm__("w26");
+
+/* fn(arg) with the guest registers zeroed, x27 = this thread's g_guest_ts,
+ * and the caller's x19-x27 back afterwards (xbox_guest_regs.c). */
+void *xbox_guest_regs_call(void *(*fn)(void *), void *arg);
+
+/*
+ * The rest of the per-thread guest state -- x87 stack and status, the SEH
+ * ebp bridge, DF, the loop budget, SSE and MMX -- in one __thread block
+ * (g_guest_ts, kernel_bridge.c) instead of a __thread variable each. On the
+ * Switch (-mtp=soft) every __thread access is a call to __aarch64_read_tp,
+ * ~8% of SSX3NX's game thread at stock clocks. x27 holds the block's address
+ * on every thread that runs guest code (set by xbox_guest_regs_call, the only
+ * way such a thread starts), so the translated code (RECOMP_GENERATED_CODE,
+ * recomp_types.h) reaches it with a plain load off x27. Everything else --
+ * the runtime, overrides, host threads that never set x27 -- goes through
+ * the __thread name: same storage, so the two always agree.
+ * -DXBOX_NO_GUEST_TS_BLOCK goes back to separate __thread variables.
+ */
+#if !defined(XBOX_NO_GUEST_TS_BLOCK)
+#define XBOX_GUEST_TS_IN_BLOCK 1
+
+/* Kept identical to recomp_types.h / xbox_memory_layout.h (same guards). */
+#ifndef RECOMP_MMX_DEFINED
+#define RECOMP_MMX_DEFINED
+typedef union RecompMmx {
+    __INT8_TYPE__   b[8];
+    __UINT8_TYPE__  ub[8];
+    __INT16_TYPE__  w[4];
+    __UINT16_TYPE__ uw[4];
+    __INT32_TYPE__  d[2];
+    __UINT32_TYPE__ ud[2];
+    __UINT64_TYPE__ q;
+} RecompMmx;
+#endif
+#ifndef RECOMP_XMM_DEFINED
+#define RECOMP_XMM_DEFINED
+typedef union RecompXmm {
+    float           f[4];
+    double          d[2];
+    __UINT32_TYPE__ u[4];
+    __INT32_TYPE__  i[4];
+    __UINT64_TYPE__ q[2];
+} RecompXmm;
+#endif
+
+typedef struct xbox_guest_ts {
+    double          fp_stack[8];
+    __UINT32_TYPE__ ebp, seh_ebp;
+    int             fp_cmp, df, loop_budget;
+    __UINT16_TYPE__ fp_cc, fp_control_word;
+    RecompXmm       xmm[8];
+    RecompMmx       mm[8];
+} xbox_guest_ts;
+
+extern __thread xbox_guest_ts g_guest_ts;        /* the storage, any thread */
+register xbox_guest_ts *g_guest_tsr __asm__("x27"); /* &g_guest_ts on guest threads */
+xbox_guest_ts *xbox_guest_ts_self(void);
+
+/* recomp_types.h switches the generated code to (*g_guest_tsr). */
+#define XBOX_GUEST_TS g_guest_ts
+#define g_fp_stack        (XBOX_GUEST_TS.fp_stack)
+#define g_ebp             (XBOX_GUEST_TS.ebp)
+#define g_seh_ebp         (XBOX_GUEST_TS.seh_ebp)
+#define g_fp_cmp          (XBOX_GUEST_TS.fp_cmp)
+#define g_df              (XBOX_GUEST_TS.df)
+#define g_loop_budget     (XBOX_GUEST_TS.loop_budget)
+#define g_fp_cc           (XBOX_GUEST_TS.fp_cc)
+#define g_fp_control_word (XBOX_GUEST_TS.fp_control_word)
+#define g_xmm0 (XBOX_GUEST_TS.xmm[0])
+#define g_xmm1 (XBOX_GUEST_TS.xmm[1])
+#define g_xmm2 (XBOX_GUEST_TS.xmm[2])
+#define g_xmm3 (XBOX_GUEST_TS.xmm[3])
+#define g_xmm4 (XBOX_GUEST_TS.xmm[4])
+#define g_xmm5 (XBOX_GUEST_TS.xmm[5])
+#define g_xmm6 (XBOX_GUEST_TS.xmm[6])
+#define g_xmm7 (XBOX_GUEST_TS.xmm[7])
+#define g_mm0 (XBOX_GUEST_TS.mm[0])
+#define g_mm1 (XBOX_GUEST_TS.mm[1])
+#define g_mm2 (XBOX_GUEST_TS.mm[2])
+#define g_mm3 (XBOX_GUEST_TS.mm[3])
+#define g_mm4 (XBOX_GUEST_TS.mm[4])
+#define g_mm5 (XBOX_GUEST_TS.mm[5])
+#define g_mm6 (XBOX_GUEST_TS.mm[6])
+#define g_mm7 (XBOX_GUEST_TS.mm[7])
+#endif /* !XBOX_NO_GUEST_TS_BLOCK */
+
+#endif
+#endif /* XBOX_GUEST_REGS_H */
