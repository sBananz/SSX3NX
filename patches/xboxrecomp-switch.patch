+#elif defined(__SWITCH__) /* -- audout, fed from a ring */
+
+/* Nintendo Switch: audout directly (after OpenTrickyNX, GPL-3.0-only). SDL's
+ * Switch driver hands audren one buffer and waits until it has finished
+ * playing before asking for the next, which stutters; here XA2_NX_BUFS
+ * buffers stay queued at the device. The APU frame thread pushes into a ring
+ * exactly as the web build does (single producer); the feeder thread refills
+ * each released device buffer from it (single consumer), silence when dry.
+ * audout is stereo: the 5.1 path stays off (xa2_channels() == 2). */
+#include <switch.h>
+#include <malloc.h>
+#include <stdlib.h>
+
+#define XA2_BUF_SAMPLES   1024
+#define RING_FRAMES       16384u            /* power of two, ~340 ms */
+/* 6 x 1024 = 128 ms queued at the device: 4 x 512 (43 ms) ran dry and crackled
+ * while the game streamed music and speech from the SD card. */
+#define XA2_NX_BUFS       6
+#define XA2_NX_SAMPLES    1024              /* 21.3 ms each */
+
+static int16_t g_nx_ring[RING_FRAMES * 2];
+static volatile uint32_t g_nx_wr, g_nx_rd, g_nx_underruns;
+static AudioOutBuffer g_nx_buf[XA2_NX_BUFS];
+static Thread g_nx_thread;
+static volatile int g_nx_stop;
+static int g_nx_on, g_nx_frames_written, g_nx_buf_samples = 256;
+static int g_nx_drops, g_nx_refills, g_nx_min_queued = 1 << 30;
+static uint32_t g_nx_seen_underruns;
+static int g_nx_reported_underruns;
+
+int xa2_channels(void) { return 2; }
+void xa2_surround_push(const int16_t *s, int n) { (void)s; (void)n; }
+
+static void nx_fill(AudioOutBuffer *b)
+{
+    int16_t *out = (int16_t *)b->buffer;
+    uint32_t rd = g_nx_rd, avail = __atomic_load_n(&g_nx_wr, __ATOMIC_ACQUIRE) - rd, i;
+    uint32_t take = avail < XA2_NX_SAMPLES ? avail : XA2_NX_SAMPLES;
+
+    /* De-clicked like the voices (apu_vp.c): a dry ring holds the last sample
+     * and lets it decay instead of stepping to 0, and output coming back is
+     * cross-faded in from that value over 2 ms. */
+    static float last[2], hold[2];
+    static int starved, xf = 96;
+    for (i = 0; i < take; i++) {
+        uint32_t at = ((rd + i) & (RING_FRAMES - 1)) * 2;
+        float l = g_nx_ring[at], r = g_nx_ring[at + 1];
+        if (starved) { starved = 0; xf = 0; hold[0] = last[0]; hold[1] = last[1]; }
+        if (xf < 96) {
+            float f = (float)(++xf) / 96.0f;
+            hold[0] *= 0.9917f; hold[1] *= 0.9917f;
+            l = hold[0] + (l - hold[0]) * f;
+            r = hold[1] + (r - hold[1]) * f;
+        }
+        last[0] = l; last[1] = r;
+        out[i * 2]     = (int16_t)l;
+        out[i * 2 + 1] = (int16_t)r;
+    }
+    if (take < XA2_NX_SAMPLES) {
+        starved = 1;
+        for (i = take; i < XA2_NX_SAMPLES; i++) {
+            last[0] *= 0.9917f; last[1] *= 0.9917f;
+            out[i * 2]     = (int16_t)last[0];
+            out[i * 2 + 1] = (int16_t)last[1];
+        }
+        if (g_nx_frames_written)
+            __atomic_fetch_add(&g_nx_underruns, 1, __ATOMIC_RELAXED);
+    }
+    __atomic_store_n(&g_nx_rd, rd + take, __ATOMIC_RELEASE);
+    b->data_size = XA2_NX_SAMPLES * 2 * sizeof(int16_t);
+    b->data_offset = 0;
+    armDCacheFlush(b->buffer, b->data_size);
+}
+
+static void nx_thread(void *arg)
+{
+    (void)arg;
+    while (!g_nx_stop) {
+        AudioOutBuffer *rel = NULL;
+        u32 n = 0;
+        if (R_FAILED(audoutWaitPlayFinish(&rel, &n, 100000000ull)) || !rel || !n)
+            continue;
+        do {
+            nx_fill(rel);
+            audoutAppendAudioOutBuffer(rel);
+            rel = NULL;
+            n = 0;
+        } while (R_SUCCEEDED(audoutGetReleasedAudioOutBuffer(&rel, &n)) && rel && n);
+    }
+}
+
+int xa2_init(void)
+{
+    const char *e = getenv("SSX3NX_AUDIO_PRIO");
+    int prio, i;
+    Result rc;
+
+    if (g_nx_on) return 1;
+    if (!e || !*e) e = getenv("OT_AUDIO_PRIO");
+    /* 0x24: above the game, render and present threads (0x2B..0x2D), so a busy
+     * frame never delays a refill. Lower is more urgent on Horizon. */
+    prio = (e && *e) ? (int)strtol(e, NULL, 0) : 0x24;
+    if (prio <= 0 || prio > 0x3F) prio = 0x3B;
+    if (R_FAILED(rc = audoutInitialize())) {
+        fprintf(stderr, "[XA2] audout unavailable (0x%X)\n", rc);
+        return 0;
+    }
+    if (audoutGetSampleRate() != 48000 || audoutGetChannelCount() != 2 ||
+        audoutGetPcmFormat() != PcmFormat_Int16 || R_FAILED(rc = audoutStartAudioOut())) {
+        fprintf(stderr, "[XA2] audout: %u Hz, %u channel(s), format %d (rc 0x%X): no sound\n",
+                audoutGetSampleRate(), audoutGetChannelCount(), (int)audoutGetPcmFormat(), rc);
+        audoutExit();
+        return 0;
+    }
+    for (i = 0; i < XA2_NX_BUFS; i++) {
+        size_t sz = (XA2_NX_SAMPLES * 2 * sizeof(int16_t) + 0xFFF) & ~(size_t)0xFFF;
+        g_nx_buf[i].buffer = memalign(0x1000, sz);
+        g_nx_buf[i].buffer_size = sz;
+        memset(g_nx_buf[i].buffer, 0, sz);
+        g_nx_buf[i].data_size = XA2_NX_SAMPLES * 2 * sizeof(int16_t);
+        g_nx_buf[i].data_offset = 0;
+        armDCacheFlush(g_nx_buf[i].buffer, sz);
+        audoutAppendAudioOutBuffer(&g_nx_buf[i]);
+    }
+    g_nx_stop = 0;
+    if (R_FAILED(rc = threadCreate(&g_nx_thread, nx_thread, NULL, NULL, 0x8000, prio, 2)) ||
+        R_FAILED(rc = threadStart(&g_nx_thread))) {
+        fprintf(stderr, "[XA2] audout thread failed (0x%X)\n", rc);
+        audoutStopAudioOut();
+        audoutExit();
+        return 0;
+    }
+    g_nx_on = 1;
+    fprintf(stderr, "[XA2] audout: 48000 Hz stereo 16-bit, %d x %d-sample buffers, thread priority 0x%X\n",
+            XA2_NX_BUFS, XA2_NX_SAMPLES, prio);
+    return 1;
+}
+
+void xa2_shutdown(void)
+{
+    int i;
+    if (!g_nx_on) return;
+    g_nx_stop = 1;
+    threadWaitForExit(&g_nx_thread);
+    threadClose(&g_nx_thread);
+    audoutStopAudioOut();
+    audoutExit();
+    for (i = 0; i < XA2_NX_BUFS; i++) free(g_nx_buf[i].buffer);
+    g_nx_on = 0;
+    fprintf(stderr, "[XA2] Shut down (%d frames written)\n", g_nx_frames_written);
+}
+
+int xa2_is_active(void) { return g_nx_on; }
+
+static int nx_queued(int buf_samples)
+{
+    uint32_t n = __atomic_load_n(&g_nx_wr, __ATOMIC_RELAXED)
+               - __atomic_load_n(&g_nx_rd, __ATOMIC_ACQUIRE);
+    return (int)(n / (uint32_t)buf_samples);
+}
+
+static void nx_push(const int16_t *s, uint32_t frames)
+{
+    /* The cushion pushed after running dry (s == NULL) continues the last
+     * sample with a decay rather than a step to 0; the samples after it
+     * fade in over 2 ms. */
+    static float last[2];
+    static int fade = 96;
+    uint32_t wr = g_nx_wr, i;
+    for (i = 0; i < frames; i++) {
+        uint32_t at = ((wr + i) & (RING_FRAMES - 1)) * 2;
+        float l, r;
+        if (s) {
+            l = s[i * 2]; r = s[i * 2 + 1];
+            if (fade < 96) {
+                float f = (float)(++fade) / 96.0f;
+                l = last[0] * 0.9917f + (l - last[0] * 0.9917f) * f;
+                r = last[1] * 0.9917f + (r - last[1] * 0.9917f) * f;
+            }
+        } else {
+            l = last[0] * 0.9917f; r = last[1] * 0.9917f;
+            fade = 0;
+        }
+        last[0] = l; last[1] = r;
+        g_nx_ring[at]     = (int16_t)l;
+        g_nx_ring[at + 1] = (int16_t)r;
+    }
+    /* Release: no TSO on the A57 (PORTING_PLAN.md F10), the samples must be
+     * visible before the position that publishes them. */
+    __atomic_store_n(&g_nx_wr, wr + frames, __ATOMIC_RELEASE);
+}
+
+/* Same queue policy as the web ring: device buffers are pulled on their own
+ * clock, so keep a cushion of 8 submit-sized buffers after running dry. */
+int xa2_submit_samples(const int16_t *samples, int num_samples)
+{
+    int queued, max_queued;
+
+    if (!g_nx_on) return 0;
+    if (num_samples > XA2_BUF_SAMPLES) num_samples = XA2_BUF_SAMPLES;
+    g_nx_buf_samples = num_samples;
+    queued = nx_queued(num_samples);
+    if (num_samples <= 256 && queued <= 1) {
+        nx_push(NULL, (uint32_t)((8 - queued) * num_samples));
+        if (g_nx_frames_written)
+            g_nx_refills++;
+        queued = 8;
+    }
+    if (queued < g_nx_min_queued)
+        g_nx_min_queued = queued;
+    max_queued = num_samples <= 256 ? 16 : 4;
+    if (queued >= max_queued) { g_nx_drops++; return 0; }
+    nx_push(samples, (uint32_t)num_samples);
+    g_nx_frames_written++;
+    return 1;
+}
+
+void xa2_take_stats(int *underruns, int *drops, int *min_queued, int *waits, int *refills)
+{
+    uint32_t u = __atomic_load_n(&g_nx_underruns, __ATOMIC_RELAXED);
+    g_nx_reported_underruns = (int)(u - g_nx_seen_underruns);
+    g_nx_seen_underruns = u;
+    *waits = 0;
+    *refills = g_nx_refills;
+    *underruns = g_nx_reported_underruns;
+    *drops = g_nx_drops;
+    *min_queued = g_nx_min_queued == 1 << 30 ? -1 : g_nx_min_queued;
+    g_nx_drops = g_nx_refills = 0;
+    g_nx_min_queued = 1 << 30;
+}
+
+int xa2_queued(void)
+{
+    return g_nx_on ? nx_queued(g_nx_buf_samples) : 0;
+}
+
+int xa2_get_buffer_size(void)
+{
+    return XA2_BUF_SAMPLES;
+}
