+/**
+ * Nintendo Switch counterpart of fb_present_sdl.c: the guest framebuffer (or
+ * a GPU backend's published frame) on the screen through libnx's Framebuffer,
+ * with no SDL video -- which also keeps devkitPro SDL2's Mesa EGL out of a
+ * build that links mesa-switch NVK (PORTING_PLAN.md §4.8).
+ *
+ * Present path after OpenTrickyNX's XBOX_VK_PRESENT=fb (GPL-3.0-only,
+ * xboxrecomp/src/d3d/d3d8_vk_core.c): a double-buffered linear RGBA8888
+ * framebuffer on the default NWindow, filled on a present thread. Two buffers
+ * make framebufferBegin wait for a free one, so the thread runs at vsync.
+ * The image is scaled with its aspect kept (4:3 pillarboxed, a widescreen
+ * published frame fills the screen). The VI layer scales 1280x720 to the
+ * docked 1080p output.
+ *
+ * The thread also services appletMainLoop(): HOME, sleep and the exit request
+ * from the system go through it, and a false return ends the program (exit(),
+ * not _exit(), so libnx's own teardown runs and hbmenu comes back).
+ *
+ * Same contract as the other presenters otherwise; RECOMP_FB_WINDOW=0 turns it
+ * off (on the Switch it is on by default -- there is no other output).
+ */
+#include <stdint.h>
+
+#if defined(__SWITCH__)
+#include <switch.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stddef.h>
+#include <time.h>
+#include <unistd.h>
+void xbox_FramebufferApplyGamma(uint32_t *px, size_t n);   /* fb_gamma.c */
+extern void *xbox_GuestToHost(uint32_t va);                 /* xbox_memory_layout.c */
+void xbox_switch_thread_core(int ideal);                    /* win32_compat.c */
+
+#define NX_W 1280
+#define NX_H 720
+
+static volatile int  s_fb_running;
+static uint32_t      s_fb_va, s_fb_pitch, s_fb_width = 640, s_fb_height = 480;
+static uint32_t     *s_present[2];
+static volatile int  s_present_idx = -1;
+static volatile uint32_t s_present_seq;
+static char          s_title[48] = "Xbox Recomp";
+static volatile int  s_flips, s_frame_draws;
+/* The window: 1 = the Vulkan swapchain asked for it / has it (see
+ * xbox_FramebufferHandOver below). */
+static volatile int  s_win_req, s_win_given;
+
+/* The GPU backend's frames, triple-buffered: the publisher fills a buffer that
+ * is neither the newest nor the one being shown, then makes it the newest;
+ * the present thread shows the newest straight from its buffer. (It used to
+ * copy the frame again first: one more 3.7 MB pass per frame at 720p.) */
+static pthread_mutex_t s_hi_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint32_t *s_hb[3];
+static size_t    s_hb_cap[3];
+static uint32_t  s_hb_w[3], s_hb_h[3];
+static int       s_hi_latest = -1, s_hi_reading = -1;
+static volatile uint32_t s_hi_seq;
+static double    s_hi_at;
+
+static double now_ms(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+int xbox_FramebufferClientSize(int *w, int *h)
+{
+    *w = NX_W;
+    *h = NX_H;
+    return 1;
+}
+
+void xbox_FramebufferWindowSet(uint32_t fb_va, uint32_t pitch)
+{
+    const char *pin = getenv("RECOMP_FB_VA");
+
+    s_fb_va = pin ? (uint32_t)strtoul(pin, NULL, 0) : fb_va;
+    if (pitch)
+        s_fb_pitch = pitch;
+}
+
+/* Guest row (X8R8G8B8 or R5G6B5) -> 0xAARRGGBB words. */
+static void fb_convert_row(const uint8_t *row, uint32_t *dst, uint32_t bpp)
+{
+    uint32_t x;
+
+    if (bpp == 4) {
+        memcpy(dst, row, (size_t)s_fb_width * 4);
+    } else if (bpp == 2) {
+        const uint16_t *p = (const uint16_t *)row;
+        for (x = 0; x < s_fb_width; x++) {
+            uint16_t v = p[x];
+            uint32_t r = (uint32_t)((v >> 11) & 0x1F) * 255u / 31u;
+            uint32_t g = (uint32_t)((v >>  5) & 0x3F) * 255u / 63u;
+            uint32_t b = (uint32_t)( v        & 0x1F) * 255u / 31u;
+            dst[x] = (r << 16) | (g << 8) | b;
+        }
+    } else {
+        memset(dst, 0, (size_t)s_fb_width * 4);
+    }
+}
+
+/* A GPU backend's own full-resolution frame (Vulkan): shown instead of the
+ * guest surface while it keeps coming. */
+void xbox_FramebufferPublishImage(const uint32_t *px, uint32_t w, uint32_t h)
+{
+    size_t bytes = (size_t)w * h * 4;
+    int k;
+    if (!px || !w || !h)
+        return;
+    pthread_mutex_lock(&s_hi_lock);
+    for (k = 0; k < 3 && (k == s_hi_latest || k == s_hi_reading); k++)
+        ;
+    pthread_mutex_unlock(&s_hi_lock);
+    if (k == 3)
+        return;
+    /* Buffer k is the publisher's alone until it is made the newest. */
+    if (s_hb_cap[k] < bytes) {
+        free(s_hb[k]);
+        s_hb[k] = (uint32_t *)malloc(bytes);
+        s_hb_cap[k] = s_hb[k] ? bytes : 0;
+        if (!s_hb[k])
+            return;
+    }
+    memcpy(s_hb[k], px, bytes);
+    s_hb_w[k] = w;
+    s_hb_h[k] = h;
+    pthread_mutex_lock(&s_hi_lock);
+    s_hi_latest = k;
+    s_hi_seq++;
+    s_hi_at = now_ms();
+    pthread_mutex_unlock(&s_hi_lock);
+}
+
+/* Called by the pushbuffer executor when the title flips. */
+void xbox_FramebufferWindowPresent(uint32_t fb_va, uint32_t pitch)
+{
+    const uint8_t *src;
+    int next;
+    uint32_t bpp, y;
+    size_t n = (size_t)s_fb_width * s_fb_height;
+
+    if (!s_fb_running || !fb_va || !pitch)
+        return;
+    /* The Vulkan swapchain has the window: nothing shows this copy (it was
+     * a 640x480 conversion on every flip, ~3.4% of the executor). */
+    if (s_win_req)
+        return;
+    if (getenv("RECOMP_FB_VA"))
+        return;
+    next = (s_present_idx == 0) ? 1 : 0;
+    if (!s_present[next]) {
+        s_present[next] = (uint32_t *)calloc(n, 4);
+        if (!s_present[next])
+            return;
+    }
+    bpp = pitch / s_fb_width;
+    src = (const uint8_t *)xbox_GuestToHost(fb_va);   /* page map: not offset + va */
+    for (y = 0; y < s_fb_height; y++)
+        fb_convert_row(src + (size_t)y * pitch,
+                       s_present[next] + (size_t)y * s_fb_width, bpp);
+    __atomic_store_n(&s_present_idx, next, __ATOMIC_RELEASE);
+    __atomic_fetch_add(&s_present_seq, 1, __ATOMIC_RELEASE);
+}
+
+void xbox_FramebufferWindowSetTitle(const uint16_t *name, int max_chars)
+{
+    int i;
+
+    for (i = 0; i < max_chars && i < 47 && name[i]; i++)
+        s_title[i] = (char)name[i];
+    if (i)
+        s_title[i] = 0;
+}
+
+static int cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y;
+}
+
+/* RECOMP_FRAME_STATS=1: [FRAMES] line once a second, as on the other hosts. */
+void xbox_FramebufferWindowFrameStats(uint32_t draws)
+{
+    static int on = -1;
+    static double last, window, dt[2048];
+    static int n;
+    double t;
+
+    __atomic_fetch_add(&s_flips, 1, __ATOMIC_RELAXED);
+    s_frame_draws = (int)draws;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_FRAME_STATS");
+        on = e && *e && *e != '0';
+    }
+    if (!on)
+        return;
+    t = now_ms();
+    if (last && n < (int)(sizeof dt / sizeof dt[0]))
+        dt[n++] = t - last;
+    last = t;
+    if (!window)
+        window = t;
+    if (t - window >= 1000.0 && n) {
+        double secs = (t - window) / 1000.0;
+        qsort(dt, (size_t)n, sizeof dt[0], cmp_double);
+        fprintf(stderr, "[FRAMES] n %d fps %.1f p50 %.1f p99 %.1f max %.1f ms draws %u\n",
+                n, n / secs, dt[n / 2],
+                dt[(n * 99) / 100 < n ? (n * 99) / 100 : n - 1], dt[n - 1], draws);
+        n = 0;
+        window = t;
+    }
+}
+
+/* No keyboard on the Switch: the pad is the only input. */
+int xbox_FramebufferKeyDown(int vk)    { (void)vk; return 0; }
+int xbox_FramebufferKeyPresses(int vk) { (void)vk; return 0; }
+
+/* px: w*h pixels, 0xAARRGGBB, top row first. */
+static int write_bmp(const char *path, const uint32_t *px, uint32_t w, uint32_t h)
+{
+    FILE *f;
+    uint32_t row = ((w * 3u) + 3u) & ~3u;
+    uint32_t img = row * h, total = 54u + img, y, x;
+    uint8_t hdr[54], *line;
+
+    f = fopen(path, "wb");
+    if (!f)
+        return -1;
+    memset(hdr, 0, sizeof(hdr));
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &total, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &w, 4);
+    memcpy(hdr + 22, &h, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    memcpy(hdr + 34, &img, 4);
+    fwrite(hdr, 1, sizeof(hdr), f);
+    line = (uint8_t *)calloc(1, row);
+    for (y = 0; y < h; y++) {
+        const uint32_t *src = px + (size_t)(h - 1 - y) * w;
+        for (x = 0; x < w; x++) {
+            line[x * 3 + 0] = (uint8_t)(src[x] & 0xFF);
+            line[x * 3 + 1] = (uint8_t)((src[x] >> 8) & 0xFF);
+            line[x * 3 + 2] = (uint8_t)((src[x] >> 16) & 0xFF);
+        }
+        fwrite(line, 1, row, f);
+    }
+    free(line);
+    fclose(f);
+    return 0;
+}
+
+int xbox_FramebufferDumpBmp(const char *path)
+{
+    int idx = __atomic_load_n(&s_present_idx, __ATOMIC_ACQUIRE);
+
+    if (idx < 0 || !s_present[idx])
+        return -1;
+    if (write_bmp(path, s_present[idx], s_fb_width, s_fb_height))
+        return -1;
+    fprintf(stderr, "  [FBWIN] wrote %s (%ux%u from 0x%08X)\n",
+            path, s_fb_width, s_fb_height, s_fb_va);
+    return 0;
+}
+
+void xbox_FramebufferSnapshot(const char *path)
+{
+    pthread_mutex_lock(&s_hi_lock);
+    if (s_hi_latest >= 0 && now_ms() - s_hi_at < 250.0) {
+        int k = s_hi_latest;
+        write_bmp(path, s_hb[k], s_hb_w[k], s_hb_h[k]);   /* not refilled while latest */
+        pthread_mutex_unlock(&s_hi_lock);
+        return;
+    }
+    pthread_mutex_unlock(&s_hi_lock);
+    xbox_FramebufferDumpBmp(path);
+}
+
+/* fb_gamma.c: the title's ramp, NULL while it is the identity. */
+const uint8_t *xbox_FramebufferGammaLut(void);
+
+/* One screen pixel: 0xAARRGGBB -> RGBA8888 bytes (0xAABBGGRR), opaque. */
+static inline uint32_t to_screen(uint32_t v)
+{
+    return 0xFF000000u | (__builtin_bswap32(v) >> 8);
+}
+
+static inline uint32_t to_screen_lut(uint32_t v, const uint8_t *lut)
+{
+    return 0xFF000000u | (uint32_t)lut[512 + (v & 0xFFu)] << 16
+         | (uint32_t)lut[256 + ((v >> 8) & 0xFFu)] << 8 | lut[(v >> 16) & 0xFFu];
+}
+
+/* src (0xAARRGGBB, sw x sh) -> the RGBA8888 screen (bytes R,G,B,A, i.e.
+ * 0xAABBGGRR words), nearest-neighbour, aspect kept, black bars, with the
+ * gamma ramp applied on the way -- one pass over the frame. (Gamma used to
+ * be its own pass over a copy first.) A frame the screen's size (the 720p
+ * widescreen frame) is a straight row conversion. */
+static void blit_scaled(uint32_t *dst, uint32_t dst_stride_px,
+                        const uint32_t *src, uint32_t sw, uint32_t sh)
+{
+    uint32_t ow, oh, ox, oy, x, y;
+    static uint32_t xmap[NX_W];
+    const uint8_t *lut = xbox_FramebufferGammaLut();
+
+    if (sw == NX_W && sh == NX_H) {
+        for (y = 0; y < NX_H; y++) {
+            const uint32_t *s = src + (size_t)y * NX_W;
+            uint32_t *d = dst + (size_t)y * dst_stride_px;
+            if (lut)
+                for (x = 0; x < NX_W; x++)
+                    d[x] = to_screen_lut(s[x], lut);
+            else
+                for (x = 0; x < NX_W; x++)
+                    d[x] = to_screen(s[x]);
+        }
+        return;
+    }
+
+    /* Fit: the source's aspect, as large as the screen allows. */
+    if ((uint64_t)sw * NX_H >= (uint64_t)sh * NX_W) {
+        ow = NX_W;
+        oh = (uint32_t)((uint64_t)sh * NX_W / sw);
+    } else {
+        oh = NX_H;
+        ow = (uint32_t)((uint64_t)sw * NX_H / sh);
+    }
+    if (!ow) ow = 1;
+    if (!oh) oh = 1;
+    ox = (NX_W - ow) / 2;
+    oy = (NX_H - oh) / 2;
+    for (x = 0; x < ow; x++)
+        xmap[x] = (uint32_t)((uint64_t)x * sw / ow);
+    for (y = 0; y < NX_H; y++) {
+        uint32_t *d = dst + (size_t)y * dst_stride_px;
+        if (y < oy || y >= oy + oh) {
+            memset(d, 0, NX_W * 4);
+            continue;
+        }
+        {
+            const uint32_t *s = src + (size_t)((uint64_t)(y - oy) * sh / oh) * sw;
+            if (ox)
+                memset(d, 0, ox * 4);
+            if (lut)
+                for (x = 0; x < ow; x++)
+                    d[ox + x] = to_screen_lut(s[xmap[x]], lut);
+            else
+                for (x = 0; x < ow; x++)
+                    d[ox + x] = to_screen(s[xmap[x]]);
+            if (ox + ow < NX_W)
+                memset(d + ox + ow, 0, (NX_W - ox - ow) * 4);
+        }
+    }
+}
+
+/* ── Straight into the window's own layout ────────────────────────────────
+ * framebufferMakeLinear gives a linear shadow that framebufferEnd then
+ * converts, all of it, into the buffer's block-linear layout on the CPU: a
+ * second pass over 3.7 MB, read and written cold, every frame ([GPROF] P:
+ * framebufferEnd ~10% of the present thread, which is ~30% of a core and
+ * shares the three cores with the game and the executor). Without it
+ * framebufferBegin hands out the real buffer, and the blit writes each 16
+ * bytes where they belong: one pass, sequential stores. The layout, from
+ * libnx's framebufferEnd: Tegra block linear, blocks of 16 GOBs (128 rows)
+ * high; a GOB is 64 bytes x 8 rows (512 bytes), its 16-byte chunk i at x
+ * bytes 32 * bit4 + 16 * bit1, row bit0 + 2 * bits 2-3. RECOMP_FB_TILED=0:
+ * the linear shadow as before. */
+static inline size_t bl_off(uint32_t xb, uint32_t y, uint32_t stride)
+{
+    return (size_t)(y >> 7) * ((size_t)stride << 7) + (size_t)(xb >> 6) * 8192u
+         + ((y & 127u) >> 3) * 512u + ((xb & 63u) >> 5) * 256u + ((y & 7u) >> 1) * 64u
+         + ((xb & 31u) >> 4) * 32u + (y & 1u) * 16u + (xb & 15u);
+}
+
+/* src: NX_W x NX_H, either 0xAARRGGBB (conv: through to_screen / the ramp)
+ * or already screen words (conv 0: copied). stride == NX_W * 4. */
+static void blit_tiled(uint8_t *dst, uint32_t stride, const uint32_t *src, int conv)
+{
+    /* One 8-row strip (a row of GOBs) at a time, left to right: the source is
+     * read as 8 sequential streams the prefetcher follows. (Walking a GOB
+     * column down a 128-row block first, libnx's order, read each 64-byte
+     * line from a different row: every line a cold miss, 34% of the present
+     * thread against 22% for the linear copy + libnx's pass it replaced.) */
+    const uint8_t *lut = conv ? xbox_FramebufferGammaLut() : NULL;
+    uint32_t y0, gx, i, k;
+    for (y0 = 0; y0 < NX_H; y0 += 8) {
+        uint8_t *band = dst + (size_t)(y0 >> 7) * ((size_t)stride << 7) + ((y0 & 127u) >> 3) * 512u;
+        const uint32_t *rows = src + (size_t)y0 * NX_W;
+        for (gx = 0; gx < NX_W / 16; gx++) {
+            uint32_t *o = (uint32_t *)(band + (size_t)gx * 8192u);
+            if (gx + 4 < NX_W / 16)
+                for (k = 0; k < 8; k++)
+                    __builtin_prefetch(rows + k * NX_W + (gx + 4) * 16);
+            for (i = 0; i < 32; i++, o += 4) {
+                uint32_t r = (i & 1u) + ((i >> 2) & 3u) * 2;
+                const uint32_t *s = rows + r * NX_W + gx * 16 + ((i >> 4) & 1u) * 8 + ((i >> 1) & 1u) * 4;
+                if (!conv)
+                    for (k = 0; k < 4; k++) o[k] = s[k];
+                else if (lut)
+                    for (k = 0; k < 4; k++) o[k] = to_screen_lut(s[k], lut);
+                else
+                    for (k = 0; k < 4; k++) o[k] = to_screen(s[k]);
+            }
+        }
+    }
+}
+
+/* The FPS overlay's corner (x < OV_W, y < OV_H), out of / back into the
+ * block-linear screen, so overlay_line keeps drawing on linear pixels. */
+#define OV_W 640
+#define OV_H 80
+static void tiled_rect(uint8_t *scr, uint32_t stride, uint32_t *lin, int back)
+{
+    uint32_t x, y;
+    for (y = 0; y < OV_H; y++)
+        for (x = 0; x < OV_W; x += 4) {
+            uint32_t *t = (uint32_t *)(scr + bl_off(x * 4, y, stride)), *l = lin + y * OV_W + x;
+            if (back) { t[0] = l[0]; t[1] = l[1]; t[2] = l[2]; t[3] = l[3]; }
+            else      { l[0] = t[0]; l[1] = t[1]; l[2] = t[2]; l[3] = t[3]; }
+        }
+}
+
+/* ── CPU use (SSX3NX_CPU_STATS=1) ─────────────────────────────────────────
+ * Every 2 s, one [CPU] line: how busy each of the application's three cores
+ * was (from the kernel's idle-thread time -- only readable on the core
+ * itself, so the sampler visits each core in turn), and the CPU time of each
+ * named thread (xbox_nx_thread_name). Shown on the FPS overlay as well. This
+ * is what says whether a slow frame is the game's own code (core 0), the
+ * pushbuffer executor recording Vulkan draws, or the presenter's copies. */
+#define NX_PROF_MAX 32
+static struct { Handle h; char name[12]; u64 last; int dead; } s_prof[NX_PROF_MAX];
+static int s_nprof;
+static pthread_mutex_t s_prof_lock = PTHREAD_MUTEX_INITIALIZER;
+static char s_cpu_line[2][48];          /* for the overlay */
+
+void xbox_nx_thread_name(const char *name)
+{
+    Handle h = threadGetCurHandle();
+    int i;
+    pthread_mutex_lock(&s_prof_lock);
+    /* A thread named again (a CreateThread thread that says what it is) is
+     * renamed; a dead thread's handle value reused is a new thread. */
+    for (i = 0; i < s_nprof && s_prof[i].h != h; i++)
+        ;
+    if (i == s_nprof)
+        for (i = 0; i < s_nprof && !s_prof[i].dead; i++)
+            ;
+    if (i < NX_PROF_MAX) {
+        if (i == s_nprof)
+            s_nprof++;
+        s_prof[i].h = h;
+        snprintf(s_prof[i].name, sizeof s_prof[i].name, "%s", name);
+        s_prof[i].last = 0;
+        s_prof[i].dead = 0;
+    }
+    pthread_mutex_unlock(&s_prof_lock);
+}
+
+/* A named thread's handle (the first live one), 0 if none: for a sampling
+ * profiler that wants, say, the pushbuffer executor ("EXEC"). */
+uint32_t xbox_nx_thread_handle(const char *name)
+{
+    uint32_t h = 0;
+    int i;
+    pthread_mutex_lock(&s_prof_lock);
+    for (i = 0; i < s_nprof; i++)
+        if (!s_prof[i].dead && strcmp(s_prof[i].name, name) == 0) {
+            h = s_prof[i].h;
+            break;
+        }
+    pthread_mutex_unlock(&s_prof_lock);
+    return h;
+}
+
+/* A thread's name by its handle, for kernel_bridge.c's [GUEST] lines. */
+static const char *prof_name_of(uint32_t h)
+{
+    static char name[12];
+    int i;
+    const char *r = NULL;
+    pthread_mutex_lock(&s_prof_lock);
+    for (i = 0; i < s_nprof; i++)
+        if (s_prof[i].h == h && !s_prof[i].dead) {
+            memcpy(name, s_prof[i].name, sizeof name);
+            r = name;
+            break;
+        }
+    pthread_mutex_unlock(&s_prof_lock);
+    return r;
+}
+
+static u64 core_idle_ticks(int core)
+{
+    u64 idle = 0;
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1u << core);
+    svcSleepThread(1000000ull);           /* rescheduled onto that core */
+    if (svcGetCurrentProcessorNumber() != (u32)core)
+        return ~0ull;
+    if (R_FAILED(svcGetInfo(&idle, InfoType_IdleTickCount, INVALID_HANDLE, ~0ull)))
+        return ~0ull;
+    return idle;
+}
+
+static void *cpu_stats_thread(void *unused)
+{
+    u64 idle0[3], t0 = armGetSystemTick();
+    int c;
+    (void)unused;
+    for (c = 0; c < 3; c++)
+        idle0[c] = core_idle_ticks(c);
+    for (;;) {
+        u64 idle1[3], t1, dt;
+        char line[512], *p = line;
+        int busy[3];
+        struct { char name[12]; u64 ticks; int n; } agg[NX_PROF_MAX];
+        int na = 0, i, k;
+        svcSleepThread(2000000000ull);
+        for (c = 0; c < 3; c++)
+            idle1[c] = core_idle_ticks(c);
+        t1 = armGetSystemTick();
+        dt = t1 - t0 ? t1 - t0 : 1;
+        for (c = 0; c < 3; c++) {
+            if (idle0[c] == ~0ull || idle1[c] == ~0ull) {
+                busy[c] = -1;            /* not readable */
+            } else {
+                busy[c] = 100 - (int)((idle1[c] - idle0[c]) * 100 / dt);
+                if (busy[c] < 0) busy[c] = 0;
+                if (busy[c] > 100) busy[c] = 100;
+            }
+            idle0[c] = idle1[c];
+        }
+        pthread_mutex_lock(&s_prof_lock);
+        for (i = 0; i < s_nprof; i++) {
+            u64 tk = 0;
+            if (s_prof[i].dead)
+                continue;
+            if (R_FAILED(svcGetInfo(&tk, InfoType_ThreadTickCount, s_prof[i].h, ~0ull))) {
+                s_prof[i].dead = 1;
+                continue;
+            }
+            for (k = 0; k < na && strcmp(agg[k].name, s_prof[i].name); k++)
+                ;
+            if (k == na) {
+                memcpy(agg[k].name, s_prof[i].name, sizeof agg[k].name);
+                agg[k].ticks = 0; agg[k].n = 0; na++;
+            }
+            if (s_prof[i].last)
+                agg[k].ticks += tk - s_prof[i].last;
+            agg[k].n++;
+            s_prof[i].last = tk;
+        }
+        pthread_mutex_unlock(&s_prof_lock);
+        t0 = t1;
+        p += snprintf(p, sizeof line - (size_t)(p - line), "[CPU] busy: core0 %d%% core1 %d%% core2 %d%% | threads (%% of a core):",
+                      busy[0], busy[1], busy[2]);
+        snprintf(s_cpu_line[0], sizeof s_cpu_line[0], "CPU %d %d %d", busy[0], busy[1], busy[2]);
+        {
+            /* busiest first */
+            char top[48] = "", *tp = top;
+            int r;
+            for (r = 0; r < na; r++) {
+                int b = -1, pct;
+                for (k = 0; k < na; k++)
+                    if (agg[k].n && (b < 0 || agg[k].ticks > agg[b].ticks))
+                        b = k;
+                if (b < 0)
+                    break;
+                pct = (int)(agg[b].ticks * 100 / dt);
+                if (agg[b].n > 1)
+                    p += snprintf(p, sizeof line - (size_t)(p - line), " %s(x%d) %d", agg[b].name, agg[b].n, pct);
+                else
+                    p += snprintf(p, sizeof line - (size_t)(p - line), " %s %d", agg[b].name, pct);
+                if (r < 3 && tp - top < (int)sizeof top - 16)
+                    tp += snprintf(tp, sizeof top - (size_t)(tp - top), "%s%s %d", r ? " " : "", agg[b].name, pct);
+                agg[b].n = 0;
+                if ((size_t)(p - line) > sizeof line - 24)
+                    break;
+            }
+            snprintf(s_cpu_line[1], sizeof s_cpu_line[1], "%s", top);
+        }
+        fprintf(stderr, "%s\n", line);
+        {
+            /* and where each guest thread's time went (kernel_bridge.c) */
+            extern void xbox_GuestKernelReport(const char *(*name_of)(uint32_t), uint64_t dt);
+            xbox_GuestKernelReport(prof_name_of, dt);
+        }
+    }
+    return NULL;
+}
+
+/* ── FPS overlay (RECOMP_FPS_OVERLAY=1, as on the PC) ───────────────────────
+ * Top-left of the screen, refreshed once a second:
+ *   FPS 13.7  DRAWS 850
+ * and with SSX3NX_CPU_STATS=1 the cores' load and the three busiest threads
+ * (% of one core). A 5x7 pixel font (fb_present.c's), drawn into the
+ * presented frame after the blit, in a darkened box. */
+static const unsigned char *glyph(char ch)
+{
+    static const unsigned char g_digits[10][7] = {
+        {0x0E,0x11,0x13,0x15,0x19,0x11,0x0E}, {0x04,0x0C,0x04,0x04,0x04,0x04,0x0E},
+        {0x0E,0x11,0x01,0x02,0x04,0x08,0x1F}, {0x1F,0x02,0x04,0x02,0x01,0x11,0x0E},
+        {0x02,0x06,0x0A,0x12,0x1F,0x02,0x02}, {0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E},
+        {0x06,0x08,0x10,0x1E,0x11,0x11,0x0E}, {0x1F,0x01,0x02,0x04,0x08,0x08,0x08},
+        {0x0E,0x11,0x11,0x0E,0x11,0x11,0x0E}, {0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C}};
+    static const struct { char c; unsigned char rows[7]; } g_letters[] = {
+        {'A', {0x0E,0x11,0x11,0x1F,0x11,0x11,0x11}}, {'B', {0x1E,0x11,0x11,0x1E,0x11,0x11,0x1E}},
+        {'C', {0x0E,0x11,0x10,0x10,0x10,0x11,0x0E}}, {'D', {0x1E,0x11,0x11,0x11,0x11,0x11,0x1E}},
+        {'E', {0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F}}, {'F', {0x1F,0x10,0x10,0x1E,0x10,0x10,0x10}},
+        {'G', {0x0E,0x11,0x10,0x17,0x11,0x11,0x0F}}, {'H', {0x11,0x11,0x11,0x1F,0x11,0x11,0x11}},
+        {'I', {0x0E,0x04,0x04,0x04,0x04,0x04,0x0E}}, {'J', {0x07,0x02,0x02,0x02,0x02,0x12,0x0C}},
+        {'K', {0x11,0x12,0x14,0x18,0x14,0x12,0x11}}, {'L', {0x10,0x10,0x10,0x10,0x10,0x10,0x1F}},
+        {'M', {0x11,0x1B,0x15,0x15,0x11,0x11,0x11}}, {'N', {0x11,0x19,0x15,0x13,0x11,0x11,0x11}},
+        {'O', {0x0E,0x11,0x11,0x11,0x11,0x11,0x0E}}, {'P', {0x1E,0x11,0x11,0x1E,0x10,0x10,0x10}},
+        {'Q', {0x0E,0x11,0x11,0x11,0x15,0x12,0x0D}}, {'R', {0x1E,0x11,0x11,0x1E,0x14,0x12,0x11}},
+        {'S', {0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E}}, {'T', {0x1F,0x04,0x04,0x04,0x04,0x04,0x04}},
+        {'U', {0x11,0x11,0x11,0x11,0x11,0x11,0x0E}}, {'V', {0x11,0x11,0x11,0x11,0x11,0x0A,0x04}},
+        {'W', {0x11,0x11,0x11,0x15,0x15,0x15,0x0A}}, {'X', {0x11,0x11,0x0A,0x04,0x0A,0x11,0x11}},
+        {'Y', {0x11,0x11,0x0A,0x04,0x04,0x04,0x04}}, {'Z', {0x1F,0x01,0x02,0x04,0x08,0x10,0x1F}},
+        {'.', {0x00,0x00,0x00,0x00,0x00,0x0C,0x0C}}, {':', {0x00,0x0C,0x0C,0x00,0x0C,0x0C,0x00}},
+        {'-', {0x00,0x00,0x00,0x1F,0x00,0x00,0x00}}, {'/', {0x01,0x01,0x02,0x04,0x08,0x10,0x10}},
+        {'(', {0x02,0x04,0x08,0x08,0x08,0x04,0x02}}, {')', {0x08,0x04,0x02,0x02,0x02,0x04,0x08}},
+        {'%', {0x18,0x19,0x02,0x04,0x08,0x13,0x03}}};
+    size_t i;
+    if (ch >= '0' && ch <= '9')
+        return g_digits[ch - '0'];
+    if (ch >= 'a' && ch <= 'z')
+        ch = (char)(ch - 'a' + 'A');
+    for (i = 0; i < sizeof g_letters / sizeof g_letters[0]; i++)
+        if (g_letters[i].c == ch)
+            return g_letters[i].rows;
+    return NULL;                        /* space and anything else */
+}
+
+/* One line of text in a box at (x0, y0) of an RGBA8888 image maxw x maxh,
+ * sc pixels per font pixel. box 0: the pixels under the box darkened to a
+ * quarter (on a finished frame); else the box is that pixel value (an
+ * overlay image with alpha, for the GPU to blend: 0xC0000000 darkens alike). */
+static void overlay_line_ex(uint32_t *px, uint32_t stride, int maxw, int maxh, const char *text,
+                            int x0, int y0, int sc, uint32_t box)
+{
+    int len = (int)strlen(text), i, bw, bh, x, y;
+    if (!len)
+        return;
+    bw = (len * 6 + 2) * sc;
+    bh = 10 * sc;
+    if (x0 + bw > maxw) bw = maxw - x0;
+    for (y = y0; y < y0 + bh && y < maxh; y++)
+        for (x = x0; x < x0 + bw; x++) {
+            uint32_t p = px[(size_t)y * stride + x];
+            px[(size_t)y * stride + x] = box ? box : 0xFF000000u | ((p >> 2) & 0x3F3F3Fu);
+        }
+    for (i = 0; i < len; i++) {
+        const unsigned char *g = glyph(text[i]);
+        int r, cx, gx = x0 + (i * 6 + 1) * sc, gy = y0 + sc + sc / 2;
+        if (!g)
+            continue;
+        for (r = 0; r < 7; r++)
+            for (cx = 0; cx < 5; cx++)
+                if (g[r] & (0x10 >> cx))
+                    for (y = gy + r * sc; y < gy + (r + 1) * sc && y < maxh; y++)
+                        for (x = gx + cx * sc; x < gx + (cx + 1) * sc && x < maxw; x++)
+                            px[(size_t)y * stride + x] = 0xFFFFFFFFu;
+    }
+}
+
+static void overlay_line(uint32_t *px, uint32_t stride, const char *text, int x0, int y0, int sc)
+{
+    overlay_line_ex(px, stride, NX_W, NX_H, text, x0, y0, sc, 0);
+}
+
+/* The overlay's text, shared with the Vulkan swapchain path (vkr.c draws it
+ * on the GPU): refreshed once a second by the present thread. */
+static pthread_mutex_t s_ov_lock = PTHREAD_MUTEX_INITIALIZER;
+static char s_fps_text[48];
+static volatile unsigned s_ov_serial;   /* 0 = nothing to show yet */
+static int s_overlay, s_cpu_stats_on;
+
+/* The overlay as an image with alpha, the screen's top-left w x h (R8G8B8A8
+ * words: transparent, 0xC0 black boxes, white text) -- the same lines, place
+ * and size as on the CPU path. Returns its serial, which changes with the
+ * text (0: overlay off or no text yet); rgba NULL: just the serial. */
+unsigned xbox_FramebufferOverlayPixels(uint32_t *rgba, int w, int h)
+{
+    char l[3][48];
+    int n = 0, i;
+    unsigned s;
+    if (!s_overlay)
+        return 0;
+    pthread_mutex_lock(&s_ov_lock);
+    s = s_ov_serial;
+    if (s && rgba) {
+        memcpy(l[0], s_fps_text, sizeof l[0]);
+        n = 1;
+        if (s_cpu_stats_on && s_cpu_line[0][0]) {
+            memcpy(l[1], s_cpu_line[0], sizeof l[1]);
+            memcpy(l[2], s_cpu_line[1], sizeof l[2]);
+            n = 3;
+        }
+    }
+    pthread_mutex_unlock(&s_ov_lock);
+    if (!rgba || !s)
+        return s;
+    memset(rgba, 0, (size_t)w * h * 4);
+    for (i = 0; i < n; i++) {
+        l[i][sizeof l[i] - 1] = 0;
+        overlay_line_ex(rgba, (uint32_t)w, w, h, l[i], 8, 8 + i * 22, 2, 0xC0000000u);
+    }
+    return s;
+}
+
+/* The window between this thread and the Vulkan swapchain (vkr.c, Switch):
+ * vkr asks for it at its first flip (HandOver: this thread closes its
+ * framebuffer -- the NWindow takes one producer -- and keeps servicing the
+ * applet loop and the [FPS] count), and hands it back if the swapchain
+ * fails (TakeBack: the framebuffer is opened again). */
+
+int xbox_FramebufferHandOver(void)
+{
+    int i;
+    s_win_req = 1;
+    if (!s_fb_running) {
+        s_win_given = 1;
+        return 1;
+    }
+    for (i = 0; i < 3000 && !s_win_given; i++)
+        svcSleepThread(1000000ull);
+    return s_win_given;
+}
+
+void xbox_FramebufferTakeBack(void)
+{
+    s_win_req = 0;
+}
+
+static int fb_open(Framebuffer *fb, int tiled)
+{
+    if (R_FAILED(framebufferCreate(fb, nwindowGetDefault(), NX_W, NX_H, PIXEL_FORMAT_RGBA_8888, 2)))
+        return 0;
+    if (!tiled)
+        framebufferMakeLinear(fb);
+    return 1;
+}
+
+/* [FPS] once a second, and the overlay's first line. */
+static void fps_tick(int show_fps, double *t0, int *f0)
+{
+    double now;
+    if (!show_fps && !s_overlay)
+        return;
+    now = now_ms();
+    if (now - *t0 >= 1000.0) {
+        int f = s_flips;
+        double fps = *t0 ? (f - *f0) * 1000.0 / (now - *t0) : 0.0;
+        if (show_fps)
+            fprintf(stderr, "[FPS] %s %.1f draws %d\n", s_title, fps, s_frame_draws);
+        pthread_mutex_lock(&s_ov_lock);
+        snprintf(s_fps_text, sizeof s_fps_text, "FPS %.1f  DRAWS %d", fps, s_frame_draws);
+        if (!++s_ov_serial)
+            s_ov_serial = 1;
+        pthread_mutex_unlock(&s_ov_lock);
+        *t0 = now; *f0 = f;
+    }
+}
+
+static void *fb_thread(void *unused)
+{
+    Framebuffer fb;
+    uint32_t *frame = NULL, fw = 0, fh = 0;
+    uint32_t last_seq = ~0u, last_hi = ~0u;
+    double t0 = 0;
+    int f0 = 0, show_fps, overlay, cpu_stats, tiled, have_fb = 0;
+    uint32_t *lin = NULL;                   /* tiled: a scaled frame, before tiling */
+    static uint32_t ov[OV_W * OV_H];        /* tiled: the overlay's corner */
+
+    (void)unused;
+    xbox_switch_thread_core(1);   /* with the pushbuffer pump, off the game's core */
+    xbox_nx_thread_name("PRESENT");
+    {
+        const char *e = getenv("XBOX_SHOW_FPS");
+        show_fps = e && *e && *e != '0';
+        e = getenv("RECOMP_FPS_OVERLAY");
+        overlay = s_overlay = e && *e && *e != '0';
+        e = getenv("SSX3NX_CPU_STATS");
+        cpu_stats = s_cpu_stats_on = e && *e && *e != '0';
+        e = getenv("RECOMP_FB_TILED");
+        tiled = !(e && *e == '0');
+    }
+    fprintf(stderr, "  [FBWIN] FPS overlay %s\n", overlay ? "on (RECOMP_FPS_OVERLAY)" : "off");
+    if (!s_win_req) {
+        if (!(have_fb = fb_open(&fb, tiled))) {
+            fprintf(stderr, "  [FBWIN] framebufferCreate failed\n");
+            s_fb_running = 0;
+            return NULL;
+        }
+        fprintf(stderr, "  [FBWIN] libnx framebuffer %ux%u, %s\n", NX_W, NX_H,
+                tiled ? "written block-linear by the blit (RECOMP_FB_TILED)" : "linear shadow, converted by libnx");
+    }
+
+    if (cpu_stats) {
+        pthread_t th;
+        if (pthread_create(&th, NULL, cpu_stats_thread, NULL) == 0)
+            pthread_detach(th);
+    }
+
+    while (s_fb_running) {
+        int fresh = 0, idx;
+        uint32_t stride, seq;
+        uint32_t *screen;
+        const uint32_t *show = NULL;   /* the image to blit this time */
+        uint32_t sw = 0, sh = 0;
+
+        if (!appletMainLoop()) {
+            fprintf(stderr, "  [FBWIN] exit requested by the system\n");
+            fflush(NULL);
+            exit(0);
+        }
+        fps_tick(show_fps, &t0, &f0);
+
+        /* The Vulkan swapchain has the window: only the applet loop and the
+         * FPS count here. */
+        if (s_win_req) {
+            if (have_fb) {
+                framebufferClose(&fb);
+                have_fb = 0;
+                pthread_mutex_lock(&s_hi_lock);
+                s_hi_reading = -1;
+                pthread_mutex_unlock(&s_hi_lock);
+                fprintf(stderr, "  [FBWIN] window handed to the Vulkan swapchain (RECOMP_VK_PRESENT)\n");
+            }
+            s_win_given = 1;
+            svcSleepThread(10000000ull);   /* 10 ms */
+            continue;
+        }
+        if (!have_fb) {
+            s_win_given = 0;
+            if (!(have_fb = fb_open(&fb, tiled))) {
+                svcSleepThread(100000000ull);
+                continue;
+            }
+            fprintf(stderr, "  [FBWIN] window back from the Vulkan swapchain: libnx framebuffer again\n");
+        }
+
+        /* Newest image: the GPU backend's while it keeps coming (blitted
+         * straight from its buffer, which the publisher leaves alone while it
+         * is being read), else the guest surface converted at the last flip. */
+        pthread_mutex_lock(&s_hi_lock);
+        if (s_hi_latest >= 0 && now_ms() - s_hi_at < 250.0) {
+            if (s_hi_seq != last_hi) {
+                s_hi_reading = s_hi_latest;
+                show = s_hb[s_hi_reading];
+                sw = s_hb_w[s_hi_reading];
+                sh = s_hb_h[s_hi_reading];
+                last_hi = s_hi_seq;
+                fresh = 1;
+            }
+            pthread_mutex_unlock(&s_hi_lock);
+        } else {
+            s_hi_reading = -1;
+            pthread_mutex_unlock(&s_hi_lock);
+            seq = __atomic_load_n(&s_present_seq, __ATOMIC_ACQUIRE);
+            idx = __atomic_load_n(&s_present_idx, __ATOMIC_ACQUIRE);
+            if (idx >= 0 && s_present[idx] && seq != last_seq) {
+                if (fw != s_fb_width || fh != s_fb_height) {
+                    free(frame);
+                    fw = s_fb_width; fh = s_fb_height;
+                    frame = (uint32_t *)malloc((size_t)fw * fh * 4);
+                }
+                if (frame) {
+                    memcpy(frame, s_present[idx], (size_t)fw * fh * 4);
+                    show = frame;
+                    sw = fw;
+                    sh = fh;
+                }
+                last_seq = seq;
+                fresh = 1;
+            }
+        }
+
+        if (!fresh || !show) {
+            svcSleepThread(4000000ull);   /* 4 ms: keep the applet loop serviced */
+            continue;
+        }
+        screen = (uint32_t *)framebufferBegin(&fb, &stride);
+        if (tiled && stride != NX_W * 4) {
+            fprintf(stderr, "  [FBWIN] stride %u, not %u: back to the linear shadow\n", stride, NX_W * 4);
+            tiled = 0;
+            framebufferEnd(&fb);
+            framebufferMakeLinear(&fb);
+            continue;
+        }
+        if (!tiled)
+            blit_scaled(screen, stride / 4, show, sw, sh);   /* gamma applied on the way */
+        else if (sw == NX_W && sh == NX_H)
+            blit_tiled((uint8_t *)screen, stride, show, 1);
+        else {
+            if (!lin)
+                lin = (uint32_t *)malloc((size_t)NX_W * NX_H * 4);
+            if (lin) {
+                blit_scaled(lin, NX_W, show, sw, sh);
+                blit_tiled((uint8_t *)screen, stride, lin, 0);
+            }
+        }
+
+        if (overlay && s_ov_serial) {
+            const int sc = 2, x0 = 8;
+            int y0 = 8;
+            uint32_t *opx = tiled ? ov : screen, ost = tiled ? OV_W : stride / 4;
+            char fps_text[48];
+            pthread_mutex_lock(&s_ov_lock);
+            memcpy(fps_text, s_fps_text, sizeof fps_text);
+            pthread_mutex_unlock(&s_ov_lock);
+            fps_text[sizeof fps_text - 1] = 0;
+            if (tiled)
+                tiled_rect((uint8_t *)screen, stride, ov, 0);
+            overlay_line(opx, ost, fps_text, x0, y0, sc);
+            if (cpu_stats && s_cpu_line[0][0]) {
+                char l[48];
+                y0 += 11 * sc;
+                memcpy(l, s_cpu_line[0], sizeof l); l[sizeof l - 1] = 0;
+                overlay_line(opx, ost, l, x0, y0, sc);
+                y0 += 11 * sc;
+                memcpy(l, s_cpu_line[1], sizeof l); l[sizeof l - 1] = 0;
+                overlay_line(opx, ost, l, x0, y0, sc);
+            }
+            if (tiled)
+                tiled_rect((uint8_t *)screen, stride, ov, 1);
+        }
+        framebufferEnd(&fb);
+    }
+    free(frame);
+    free(lin);
+    if (have_fb)
+        framebufferClose(&fb);
+    return NULL;
+}
+
+void xbox_FramebufferWindowStart(void)
+{
+    pthread_t th;
+    pthread_attr_t attr;
+    const char *e = getenv("RECOMP_FB_WINDOW");
+
+    if (e && e[0] == '0')
+        return;
+    if (__sync_val_compare_and_swap(&s_fb_running, 0, 1) != 0)
+        return;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 256 * 1024);
+    if (pthread_create(&th, &attr, fb_thread, NULL) == 0)
+        pthread_detach(th);
+    else
+        s_fb_running = 0;
+    pthread_attr_destroy(&attr);
+}
+
+/* Platform helpers live in xboxrecomp/src/platform/win32_compat.c. */
+#endif /* __SWITCH__ */
+
+void xbox_FramebufferOsd(const char *text)
+{
+    fprintf(stderr, "  [FBWIN] %s\n", text ? text : "");
+}
