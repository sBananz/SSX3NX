+            mres = run_mac(d->mac, a, b, c, &a0);
+        if (d->ilu)
+            ires = run_ilu(d->ilu, c);
+        if (d->mac && d->mac != 13 && d->mac_mask && d->tdst <= 12)
+            write_masked(reg[d->tdst].v, &mres, d->mac_mask);
+        if (d->ilu && d->ilu_mask) {
+            uint32_t it = d->mac ? 1u : d->tdst;
+            if (it <= 12)
